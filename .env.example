# Copy this file to .env and provide the real local password.
# Do not commit .env.

L2SHOCK__DATABASE__PASSWORD="replace_me"

# Optional future authenticated CryptoHFTData key.
# Anonymous access remains the default unless explicitly configured.
L2SHOCK__CRYPTOHFT__API_KEY=""

# Local read access to the private processed Hugging Face dataset.
# Use a fine-grained read token restricted to that dataset.
# Retain this credential during the staged B2 migration.
L2SHOCK__REMOTE__HF_TOKEN=""

# B2 S3 credentials.
# Prefer a bucket-scoped read-only key for the eventual local importer.
# A separate read/write key is used for worker publication and migration.
# Never put real credentials in this example or in config.yaml.
L2SHOCK__REMOTE__B2__KEY_ID=""
L2SHOCK__REMOTE__B2__APPLICATION_KEY=""

# Processing depth fractions are selected in the Fetch/Processing controls.
# Do not add L2SHOCK__PROCESSING__DEFAULT_DEPTH_UPPER: it is not a supported setting.