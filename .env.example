# Copy this file to .env and provide the real local password.
# Do not commit .env.

L2SHOCK__DATABASE__PASSWORD="replace_me"

# Optional future authenticated CryptoHFTData key.
# Anonymous access remains the default unless explicitly configured.
L2SHOCK__CRYPTOHFT__API_KEY=""

# Local read access to the private processed Hugging Face dataset.
# Use a fine-grained read token restricted to that dataset.
L2SHOCK__REMOTE__HF_TOKEN=""